# Copy to .env.local. Every variable is optional for local development.

# Database (libSQL). Defaults to a local SQLite file at .data/creatorhub.db.
# For a persistent deployed demo, point this at a Turso database:
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
# The Vercel Turso integration's TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are used when these are unset.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# HMAC secret for short-lived signed upload/playback URLs. Set a long random value in any deployed environment.
MEDIA_SIGNING_SECRET=

# Where uploaded files are written (local stand-in for object storage). Defaults to .data/uploads.
UPLOAD_DIR=

# Migrate + seed automatically on first request when the database is empty (true/false). Defaults to true.
AUTO_SEED=

# Simulated identity review time in seconds before a pending verification is approved. Defaults to 20.
VERIFICATION_REVIEW_SECONDS=

# Public origin of this deployment (e.g. https://creatorhub-portal.vercel.app). Used for absolute
# Open Graph/Twitter image URLs, robots.txt and sitemap.xml, so social previews resolve. Set it on every deploy.
NEXT_PUBLIC_APP_URL=
